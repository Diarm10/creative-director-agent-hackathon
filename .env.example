# Names only. Put real values in .env.local (gitignored) or in your host's environment settings.

# Meta Model API key: Muse Spark (text and vision), Muse Image, SAM 3.1. Required.
MODEL_API_KEY=

# Baseten key for Muse Spark Open (critic, fidelity and photo checks, brand rules, line sense check). Optional: without it every step runs on Meta.
BASETEN_API_KEY=

# The access code judges type into the page. Runs are refused when this is unset.
DEMO_CODE=

# Optional tuning
# MODEL_API_BASE_URL=https://api.meta.ai/v1
# BASETEN_MODEL=meta-models/muse-spark-open-1026
# STEP_PROVIDER_PLANNER=meta          (meta or baseten, also FIDELITY, FOLIO, CRITIC)
# DAILY_RUN_CAP=150                   (total runs per day, in memory, best effort)
# IP_RUN_LIMIT=40                     (runs per IP per hour, in memory, best effort)
